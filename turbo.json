{
  "$schema": "https://turborepo.org/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "GOOGLE_AI_API_KEY",
    "DEEPGRAM_API_KEY",
    "CRW_INTERNAL_URL",
    "DATABASE_NEONDB_SMARTEKAI",
    "AWS_ENDPOINT_URL_S3",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "GOOGLE_AI_IMAGE_MODEL",
    "CARS_DAILY_RENDER_CAP",
    "PUBLIC_SITE_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "NOWPAYMENTS_API_KEY",
    "NOWPAYMENTS_IPN_SECRET",
    "NOWPAYMENTS_ENV",
    "NOWPAYMENTS_IPN_IPS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "outputs": []
    }
  }
}
