{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@smartekai/auth": ["./packages/auth/src/index.ts"],
      "@smartekai/db": ["./packages/db/src/index.ts"],
      "@smartekai/billing": ["./packages/billing/src/index.ts"],
      "@smartekai/ai": ["./packages/ai/src/index.ts"],
      "@smartekai/ui": ["./packages/ui/src/index.ts"],
      "@smartekai/emails": ["./packages/emails/src/index.ts"]}},
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]}
