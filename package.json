{
  "name": "smartekai-saas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:cars": "turbo run dev --filter=cars-4by4-builder --output-logs=full",
    "dev:legal": "turbo run dev --filter=legal-os --output-logs=full",
    "dev:medical": "turbo run dev --filter=medical-os --output-logs=full",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.11.8"
  }
}
